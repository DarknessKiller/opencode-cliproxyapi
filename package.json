{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@darknesskiller/opencode-cliproxyapi",
  "version": "0.2.0",
  "description": "Fork of opencode-cliproxyapi that discovers CLIProxyAPI models and auto-configures reasoning-effort variants in OpenCode.",
  "type": "module",
  "license": "MIT",
  "author": "İbrahim BABAL",
  "homepage": "https://github.com/DarknessKiller/opencode-cliproxyapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarknessKiller/opencode-cliproxyapi.git"
  },
  "bugs": {
    "url": "https://github.com/DarknessKiller/opencode-cliproxyapi/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external @opencode-ai/plugin && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "keywords": [
    "opencode",
    "cliproxyapi",
    "llm",
    "plugin"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
